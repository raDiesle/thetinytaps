{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 300000,
  "permissions": {
    "allow": [
      "Bash(bun run verify)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun run typecheck)",
      "Bash(bun run build)",
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "deny": ["Bash(npm *)", "Bash(npx *)", "Bash(yarn *)", "Bash(bunx *)", "Bash(bun x *)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/.claude/hooks/feedback-reminder.md\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
